# Example-only local configuration. Copy this file to `.env` and replace
# every `change_me_in_production` value before deploying.

# Database settings for PostgreSQL
POSTGRES_USER=compassaq
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=db
POSTGRES_DB=compassaq
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Optional: overrideable DB URL for the API.
# If unset, the app will build a URL from POSTGRES_* variables.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=
API_PORT=8000

# Frontend: no API base URL needed in production (same-origin via Nginx).
# If you are running the frontend dev server without the proxy, you can
# optionally enable CORS on the API (see docs/CORS.md).
# Example: CORS_ALLOW_ORIGINS=http://localhost:5173
# If not set, CORS is disabled (recommended for same-origin production).
CORS_ALLOW_ORIGINS=

# Auth config
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_ISSUER=cleanaircompass-aq-api
JWT_AUDIENCE=cleanaircompass-aq-web
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# Auth security settings
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_IP_MAX=20
AUTH_LOGIN_RATE_LIMIT_GLOBAL_MAX=200
AUTH_PASSWORD_MIN_LENGTH=12

# Programmatic CSV upload
COMPASSAQ_CSV_UPLOAD_API_KEY=change_me_in_production
COMPASSAQ_CSV_UPLOAD_MAX_BYTES=1048576

# Optional external source integrations
OPENAQ_API_KEY=
PURPLEAIR_API_KEY=
AIRGRADIENT_API_KEY=
OPENAQ_TARGET_SENSOR_ID=
PURPLEAIR_SENSOR_INDEX=
PURPLEAIR_TARGET_SENSOR_ID=

# Scheduler
SCHEDULER_TICK_SECONDS=15
SCHEDULER_CREATE_DEFAULT=1

# Optional AQI/aggregation tuning
PM25_MIN_HOURS=
