{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compassaq.local/schemas/philippines-denr-expected-2i5-v2.json",
  "title": "CompassAQ analyst-approved Philippines DENR-EMB AQI expectations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "standard_code",
    "methodology_code",
    "methodology_version",
    "bundle_id",
    "source_artifacts",
    "frozen_measurement_hashes",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "2i.5-expected-2"},
    "artifact_kind": {"const": "analyst_approved_expectations"},
    "standard_code": {"const": "philippines_denr"},
    "methodology_code": {"const": "philippines_denr_aqi"},
    "methodology_version": {"const": "denr_emb_aqi_2021"},
    "bundle_id": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_candidate",
        "synthetic_candidate",
        "analyst_review_package",
        "approval_record"
      ],
      "properties": {
        "real_candidate": {"$ref": "#/$defs/artifactBinding"},
        "synthetic_candidate": {"$ref": "#/$defs/artifactBinding"},
        "analyst_review_package": {"$ref": "#/$defs/artifactBinding"},
        "approval_record": {"$ref": "#/$defs/artifactBinding"}
      }
    },
    "frozen_measurement_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openaq", "purpleair"],
      "properties": {
        "openaq": {"$ref": "#/$defs/sha256"},
        "purpleair": {"$ref": "#/$defs/sha256"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_group",
        "calculation_type",
        "source",
        "methodology",
        "derivation",
        "expected",
        "review"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "case_group": {"type": "string", "minLength": 1},
        "calculation_type": {"type": "string", "minLength": 1},
        "source": {"type": "object"},
        "methodology": {"type": "object"},
        "derivation": {"type": "object"},
        "expected": {"type": "object"},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewer",
            "reviewed_at",
            "derivation_sha256",
            "comments",
            "approval_decision",
            "exceptions"
          ],
          "properties": {
            "status": {"const": "approved"},
            "reviewer": {"type": "string", "minLength": 1},
            "reviewed_at": {"type": "string", "format": "date-time"},
            "derivation_sha256": {"$ref": "#/$defs/sha256"},
            "comments": {"type": "string", "minLength": 1},
            "approval_decision": {"const": "approved"},
            "exceptions": {"type": "array"}
          }
        }
      }
    }
  }
}
